# Copy this file to ".env.local" and fill in the values.
# .env.local is gitignored — never commit real keys.

# --- Contact / "Get a quote" form ---------------------------------------
# The inquiry form works WITHOUT this: if it's unset, the form opens the
# visitor's email app with a prefilled draft to you. Set this to have
# submissions land straight in your inbox with no mail app on their end.
#
# How to get a key (free, ~1 min, no account needed):
#   1. Go to https://web3forms.com
#   2. Enter your email (rodrigoseer.dev@gmail.com) under "Create Access Key"
#   3. They email you an access key — paste it below
#   4. Redeploy. That's it — form submissions now arrive in your inbox.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- SEO / Open Graph ----------------------------------------------------
# Production URL, used for canonical + OG image URLs.
NEXT_PUBLIC_SITE_URL=https://theseerlab.com
